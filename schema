
flowchart TD
    A([Начало]) --> B[/Ввод исходного текста и ключа/]
    B --> C{Текст и ключ<br/>не пустые?}
    C -- Нет --> E[/Вывод ошибки/]
    E --> Z([Конец])
    C -- Да --> D{В ключе есть<br/>повторяющиеся буквы?}
    D -- Да --> E
    D -- Нет --> F[Перевод текста и ключа<br/>в верхний регистр]
    F --> G[Удаление пробелов из текста]
    G --> H[Дополнение текста символами _<br/>до длины, кратной ключу]
    H --> I[Определение порядка<br/>букв ключа по алфавиту]
    I --> J[Перестановка символов<br/>в каждом блоке текста]
    J --> K[/Вывод зашифрованного текста/]
    K --> L[Обратная перестановка<br/>для расшифрования]
    L --> M[/Вывод расшифрованного текста/]
    M --> Z
